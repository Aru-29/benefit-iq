# Benefit IQ Enterprise Backend Non-Secret Environment Configuration
# All sensitive credentials and secrets MUST be stored in OpenBao Vault.

ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false

# API Server
API_HOST=0.0.0.0
API_PORT=8080
API_RELOAD=true
API_WORKERS=1
API_PREFIX=/api
API_VERSION=v1

# ClickHouse Database
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=benefitiq
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_SECURE=false

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DATABASE=0
REDIS_PASSWORD=

# Kafka Messaging (KRaft)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# OpenBao Secrets Management
OPENBAO_URL=http://localhost:8200
OPENBAO_TOKEN=root

# Security Rate Limiting
SECURITY_RATE_LIMIT_REQUESTS=100
SECURITY_RATE_LIMIT_WINDOW_SECONDS=60

# Email Integration (Gmail SMTP - Credentials stored in OpenBao secret/data/benefit-iq-be/smtp)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=placeholder_gmail@gmail.com
EMAIL_FROM_ADDRESS=noreply@benefitiq.com
EMAIL_USE_TLS=true

# CORS Security
CORS_ORIGINS=http://localhost:4200,http://localhost:3000